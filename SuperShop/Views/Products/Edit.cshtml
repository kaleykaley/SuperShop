@model SuperShop.Data.Entities.Product

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Product</h1>

<form asp-action="Edit">

    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control" />
        <span asp-validation-for="Price" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="ImageUrl"></label>
        <input asp-for="ImageUrl" class="form-control" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="LastPurchase"></label>
        <input asp-for="LastPurchase" class="form-control" />
        <span asp-validation-for="LastPurchase" class="text-danger"></span>

    </div>

    <div class="form-group">
        <label asp-for="LastSale"></label>
        <input asp-for="LastSale" class="form-control" />
        <span asp-validation-for="LastSale" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="IsAvailable"></label>
        <input asp-for="IsAvailable" />
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input asp-for="Stock" class="form-control" />
        <label asp-for="Stock"></label>
        <span asp-validation-for="Stock" class="text-danger"></span>

    </div>

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-success">Back to List</a>
    </div>

</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@model SuperShop.Data.Entities.Product

@{
    ViewData["Title"] = "Create new product";
}

<h1>New Product</h1>

<form asp-action="Create">

    <div class="form-group">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control"/>
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Price"></label>
        <input asp-for="Price" class="form-control"/>
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ImageUrl"></label>
        <input asp-for="ImageUrl" class="form-control"/>
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastPurchase"></label>
        <input asp-for="LastPurchase" class="form-control"/>
        <span asp-validation-for="LastPurchase" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="LastSale"></label>
        <input asp-for="LastSale" class="form-control"/>
        <span asp-validation-for="LastSale" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input class="form-check-input" asp-for="IsAvailable" />
        <label class="form-check-label" asp-for="IsAvailable"></label>
    </div>


    <div class="form-group">
        <label asp-for="Stock"></label>
        <input asp-for="Stock" class="form-control"/>
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>

    <br />
    <div class="form-group">
        <input type="submit" value="Create" class="btn btn-primary"/>
        <a asp-action="Index" class="btn btn-success">Back to List</a>
    </div>

</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}